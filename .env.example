# =============================================================================
# AegisSRE - Autonomous SRE Agent Configuration
# =============================================================================

# Server Port & Host
PORT=8000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 1. Groq AI Integration (Camada Gratuita)
# Obtenha sua chave gratuita em: https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3

# -----------------------------------------------------------------------------
# 2. Telegram Bot Integration
# Crie seu bot no Telegram conversando com @BotFather (/newbot)
# Descubra seu Chat ID conversando com @userinfobot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# 3. Docker & SRE Autonomous Watchdog
# -----------------------------------------------------------------------------
# O agente começa SEMPRE parado por padrão (iniciar sob demanda no painel)
AUTO_MONITOR_ENABLED=false
MONITOR_INTERVAL_SECONDS=30
ALERT_CPU_THRESHOLD=85.0
ALERT_MEM_THRESHOLD=85.0
ALERT_DISK_THRESHOLD=90.0

# -----------------------------------------------------------------------------
# 4. Storage & Persistence
# -----------------------------------------------------------------------------
DATA_DIR=./data
BACKUPS_DIR=./backups
IAC_OUTPUT_DIR=./iac_output
